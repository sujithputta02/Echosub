{
  "manifest_version": 3,
  "name": "EchoSub",
  "version": "1.0.0",
  "description": "Understand every word. Feel every scene. Interactive subtitles and AI assistance.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tts",
    "ttsEngine"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/universal.js"],
      "css": ["src/ui/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/ui/overlay.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
